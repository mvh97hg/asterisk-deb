#!/bin/sh
set -e

case "$1" in
  purge)
    echo "Purging Asterisk data and user..."

    # Remove service user/group.
    if [ -x "$(command -v deluser)" ]; then
      deluser --system --quiet asterisk || true
      delgroup --system --quiet asterisk || true
    fi

    # Remove runtime/data directories; keep config under /etc/asterisk.
    rm -rf /var/lib/asterisk
    rm -rf /var/log/asterisk
    rm -rf /var/spool/asterisk
    rm -rf /run/asterisk
  ;;

  remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
  ;;

  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
  ;;
esac

#DEBHELPER#

exit 0
